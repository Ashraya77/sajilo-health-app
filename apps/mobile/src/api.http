###############################################################################
# OPTIONAL CHECKS
###############################################################################

### Public articles
GET {{baseUrl}}/api/articles?limit=50&sort=publishedAt&order=desc
Accept: application/json

### Featured articles
GET {{baseUrl}}/api/articles?featured=true&limit=10&sort=publishedAt&order=desc
Accept: application/json

### Breaking articles
GET {{baseUrl}}/api/articles?breaking=true&limit=10&sort=publishedAt&order=desc
Accept: application/json

### Popular articles
GET {{baseUrl}}/api/articles?limit=10&sort=views&order=desc
Accept: application/json

### Active categories
GET {{baseUrl}}/api/categories?active=true
Accept: application/json

### Search
GET {{baseUrl}}/api/articles?search=Pokhara&limit=20
Accept: application/json

###############################################################################
# OPTIONAL IMAGE UPLOAD EXAMPLE
# Change the file path before running. Copy the returned data.url into an
# article's featuredImage field through PATCH or the admin editor.
###############################################################################

### Upload featured image
POST {{baseUrl}}/api/uploads/images
Content-Type: multipart/form-data; boundary=ArticleImageBoundary
Accept: application/json

--ArticleImageBoundary
Content-Disposition: form-data; name="file"; filename="article-image.jpg"
Content-Type: image/jpeg

< ./article-image.jpg
--ArticleImageBoundary--

###############################################################################
# OPTIONAL LOGOUT
###############################################################################

### Get CSRF token again before logout
# @name logoutCsrf
GET {{baseUrl}}/api/auth/csrf
Accept: application/json

### Sign out
POST {{baseUrl}}/api/auth/signout
Content-Type: application/x-www-form-urlencoded
Accept: application/json

csrfToken={{logoutCsrf.response.body.$.csrfToken}}&callbackUrl={{baseUrl}}/&json=true
