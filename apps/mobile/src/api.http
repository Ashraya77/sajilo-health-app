###############################################################################
# ARTICLES — realistic DEMO content for UI testing
###############################################################################

### 1. Featured + breaking lead story
POST {{baseUrl}}/api/articles
Content-Type: application/json
Accept: application/json

{
  "title": "Pokhara Begins New Lakeside Traffic Management Trial",
  "slug": "pokhara-lakeside-traffic-management-trial",
  "excerpt": "A new traffic-management trial is being introduced around busy Lakeside corridors to improve pedestrian movement and reduce congestion.",
  "content": "<p><strong>This is demonstration content for the news portal.</strong></p><p>Pokhara has begun a new traffic-management trial around key Lakeside corridors. The plan focuses on smoother vehicle flow, safer pedestrian crossings and clearer loading zones for local businesses.</p><h2>What is changing?</h2><p>Traffic personnel will test revised one-way sections, designated pickup areas and improved signage during peak hours.</p><blockquote>Officials say feedback from residents, visitors and businesses will be reviewed before permanent decisions are made.</blockquote><h2>What happens next?</h2><p>The trial will be monitored over the coming weeks. Road users are encouraged to follow temporary signs and allow additional travel time.</p>",
  "categoryId": "{{categoryLocal.response.body.$.data.id}}",
  "status": "PUBLISHED",
  "isFeatured": true,
  "isBreaking": true,
  "featuredImageAlt": "Traffic moving through the Lakeside area of Pokhara",
  "metaTitle": "Pokhara Starts Lakeside Traffic Trial",
  "metaDescription": "Pokhara begins a traffic-management trial around Lakeside to improve movement, pedestrian safety and congestion control."
}

### 2. Featured tourism story
POST {{baseUrl}}/api/articles
Content-Type: application/json
Accept: application/json

{
  "title": "Tourism Businesses Prepare for a Strong Autumn Season",
  "slug": "pokhara-tourism-businesses-autumn-season",
  "excerpt": "Hotels, trekking agencies and restaurants are preparing new packages and services ahead of the autumn travel season.",
  "content": "<p><strong>This is demonstration content for the news portal.</strong></p><p>Tourism businesses across Pokhara are preparing for the autumn travel season with refreshed rooms, new trekking packages and expanded local experiences.</p><h2>Focus on visitor experience</h2><p>Operators say travellers increasingly expect flexible bookings, reliable digital information and experiences connected to local culture.</p><ul><li>Updated trekking packages</li><li>Improved online booking</li><li>More local food and culture experiences</li></ul><p>Businesses are also coordinating with transport providers to make arrivals and onward travel easier.</p>",
  "categoryId": "{{categoryTourism.response.body.$.data.id}}",
  "status": "PUBLISHED",
  "isFeatured": true,
  "isBreaking": false,
  "featuredImageAlt": "Visitors enjoying a view of Pokhara",
  "metaTitle": "Pokhara Tourism Prepares for Autumn",
  "metaDescription": "Pokhara tourism businesses prepare hotels, trekking services and local experiences for the autumn travel season."
}

