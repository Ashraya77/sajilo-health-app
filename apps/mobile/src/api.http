  "status": "PUBLISHED",
  "isFeatured": false,
  "isBreaking": false,
  "featuredImageAlt": "A customer making a digital payment at a local shop",
  "metaTitle": "Pokhara Businesses Expand Digital Payments",
  "metaDescription": "Small businesses in Pokhara are adopting QR payments and digital bookkeeping tools for faster, clearer transactions."
}

