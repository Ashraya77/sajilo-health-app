{
  "name": "sajilo-health-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:mobile": "npm run start --workspace @sajilo/mobile",
    "dev:web": "npm run dev --workspace @sajilo/web",
    "android": "npm run android --workspace @sajilo/mobile",
    "ios": "npm run ios --workspace @sajilo/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:web": "npm run build --workspace @sajilo/web"
  }
}
